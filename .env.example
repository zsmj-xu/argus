ARGUS_API_KEY=replace-with-a-long-random-value
ARGUS_LLM_BASE_URL=https://llm.example.com/v1
ARGUS_LLM_API_KEY=replace-me
ARGUS_LLM_MODEL=model-name
## Optional: openai (default) or anthropic.
# ARGUS_LLM_PROTOCOL=openai
# Optional OCR limits.
# ARGUS_SCAN_DB=/var/lib/argus/service.sqlite3
# 扫描总时限和单文件时限默认关闭；0 表示不限时，正数可显式启用。
# OCR_TIMEOUT_MINUTES=0
# OCR_PROCESS_TIMEOUT_SECONDS=0
# ARGUS_MAX_QUEUE=100
# ARGUS_MAX_REPOSITORY_BYTES=1073741824
# ARGUS_MAX_REPOSITORY_FILES=50000
# Task diagnostics (event payload limit is fixed at 8 KiB).
# ARGUS_EVENT_RETENTION_DAYS=14
# ARGUS_EVENT_LIMIT=10000
# ARGUS_ACTIVITY_WARN_SECONDS=120
# ARGUS_ACTIVITY_STALE_SECONDS=300
# Enable only with an OCR binary implementing docs/ocr-events-v1.md.
# ARGUS_OCR_EVENT_PROTOCOL=1
# Optional GitLab overlay (token is supplied through a Docker secret, never here).
# ARGUS_GITLAB_HOST=gitlab.company.example
# ARGUS_GITLAB_USERNAME=read-only-user
