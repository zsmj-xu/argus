  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReportFormat": {
        "type": "string",
        "enum": [
          "json",
          "markdown",
          "sarif"
        ],
        "title": "ReportFormat"
      },
      "ScanCapabilities": {
        "properties": {
          "file_progress": {
            "type": "boolean",
            "title": "File Progress",
            "default": false
          },
          "llm_requests": {
            "type": "boolean",
            "title": "Llm Requests",
            "default": false
          },
          "event_protocol": {
            "type": "boolean",
            "title": "Event Protocol",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScanCapabilities",
        "description": "Capabilities that have been positively observed for one scan."
      },
      "ScanCoverage": {
        "properties": {
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "reviewed": {
            "type": "integer",
            "minimum": 0,
            "title": "Reviewed",
            "default": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "title": "Failed",
            "default": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0,
            "title": "Skipped",
            "default": 0
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100,
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScanCoverage",
        "description": "Truthful coverage counters; ``total`` is null when it is not known."
      },
      "ScanCreateRequest": {
        "properties": {
          "repository_url": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Repository Url"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          },
          "include": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 256,
            "title": "Include"
          },
          "exclude": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 256,
            "title": "Exclude"
          },
          "background": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ],
            "title": "Background"
          },
          "source_disclosure_confirmed": {
            "type": "boolean",
            "title": "Source Disclosure Confirmed",
            "description": "The caller confirms that selected source may be sent to the configured LLM.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repository_url"
        ],
        "title": "ScanCreateRequest",
        "description": "One full-file scan request; repository registration is not required."
      },
      "ScanDiagnosticsResponse": {
        "properties": {
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "observation": {
            "$ref": "#/components/schemas/ScanObservation"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "recent_errors": {
            "items": {
              "$ref": "#/components/schemas/ScanEvent"
            },
            "type": "array",
            "title": "Recent Errors"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scan_id",
          "observation"
        ],
        "title": "ScanDiagnosticsResponse"
      },
      "ScanErrorSummary": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryable"
          },
          "suggestion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggestion"
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScanErrorSummary",
        "description": "A bounded, actionable summary of the most recent scan error."
      },
      "ScanEvent": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "title": "Schema Version",
            "default": 1
          },
          "event_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "title": "Attempt"
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "type": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Type"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
            "default": true
          },
          "dropped": {
            "type": "boolean",
            "title": "Dropped",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "scan_id",
          "attempt",
          "type",
          "created_at"
        ],
        "title": "ScanEvent",
        "description": "One immutable sanitized event in the scan history."
      },
      "ScanEventsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScanEvent"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "type": "integer",
            "minimum": 0,
            "title": "Next Cursor"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "default": false
          },
          "oldest_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
